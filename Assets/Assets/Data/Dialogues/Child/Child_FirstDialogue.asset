  lines:
  - speakerName: Valou
    text: Tu... tu pourrais m'aider ?
    voiceClip: {fileID: 0}
  - speakerName: Chris
    text: "Oui bien s\xFBr. De quoi as-tu besoin ?"
    voiceClip: {fileID: 0}
  - speakerName: Valou
    text: "J'ai besoin que tu me ram\xE8nes du saucisson."
    voiceClip: {fileID: 0}
  - speakerName: Chris
    text: "Oui pas de probl\xE8me je te ram\xE8ne \xE7a tout de suite."
    voiceClip: {fileID: 0}
  - speakerName: Valou
    text: "Et plus vite que \xE7a."
    voiceClip: {fileID: 0}
